{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/plugin_registry.schema.json",
  "type": "object",
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin_id", "status", "manifest"],
        "properties": {
          "plugin_id": {"pattern": "^[a-z][a-z0-9_]*$"},
          "status": {"enum": ["planned", "experimental", "stable", "deprecated"]},
          "manifest": {"anyOf": [{"type": "null"}, {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"}]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
