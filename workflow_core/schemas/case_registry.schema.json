{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/case_registry.schema.json",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "status", "manifest"],
        "properties": {
          "case_id": {"type": "string"},
          "status": {"enum": ["planned", "active", "deprecated"]},
          "manifest": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
