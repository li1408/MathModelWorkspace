{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/artifact_manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "generated_at", "artifacts", "output_inventory"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "stage", "producer", "relative_path", "media_type", "sha256", "size_bytes", "source_artifacts", "model_id", "distribution"],
        "properties": {
          "artifact_id": {"type": "string"},
          "stage": {"type": "string"},
          "producer": {"type": "string"},
          "relative_path": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"},
          "media_type": {"type": "string"},
          "sha256": {"pattern": "^[a-fA-F0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "source_artifacts": {"type": "array", "items": {"type": "string"}},
          "model_id": {"type": ["string", "null"]}
          ,"distribution": {"enum": ["internal", "anonymous_candidate", "private_reference"]}
        },
        "additionalProperties": false
      }
    },
    "output_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relative_path", "sha256", "size_bytes"],
        "properties": {
          "relative_path": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"},
          "sha256": {"pattern": "^[a-fA-F0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
