{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/competition_profile.schema.json",
  "type": "object",
  "required": ["schema_version", "profile_id", "name", "scope", "rules_file", "allowed_paper_formats", "submission_artifacts", "extensions"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/identifier"},
    "name": {"type": "string", "minLength": 1},
    "scope": {"enum": ["national", "school", "practice"]},
    "rules_file": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"},
    "allowed_paper_formats": {"type": "array", "minItems": 1, "items": {"enum": ["pdf", "word"]}},
    "submission_artifacts": {"type": "array", "items": {"type": "string"}},
    "extensions": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false
}
