{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/supporting_materials_allowlist.schema.json",
  "type": "object",
  "required": ["schema_version", "entries", "extensions"],
  "properties": {
    "schema_version": {"const": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_run_id", "artifact_id", "target_path"],
        "properties": {
          "source_run_id": {"type": "string", "minLength": 1},
          "artifact_id": {"type": "string", "minLength": 1},
          "target_path": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"}
        },
        "additionalProperties": false
      }
    },
    "extensions": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false
}
