{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/requirements_matrix.schema.json",
  "type": "object",
  "required": ["schema_version", "questions", "extensions"],
  "properties": {
    "schema_version": {"const": 1},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "inputs", "outputs", "objective", "constraints", "candidate_model_ids", "validation_ids", "paper_section", "result_artifacts", "reviewer", "status"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "objective": {"type": "string", "minLength": 1},
          "constraints": {"type": "array", "items": {"type": "string"}},
          "candidate_model_ids": {"type": "array", "items": {"type": "string"}},
          "validation_ids": {"type": "array", "items": {"type": "string"}},
          "paper_section": {"type": "string", "minLength": 1},
          "result_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reviewer": {"type": ["string", "null"]},
          "status": {"enum": ["draft", "approved", "complete"]}
        },
        "additionalProperties": false
      }
    },
    "extensions": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false
}
