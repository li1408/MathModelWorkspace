{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/case.schema.json",
  "type": "object",
  "required": ["schema_version", "case_id", "project_relative_path", "runner_id", "runner_module", "plugin_ids", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string"},
    "project_relative_path": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"},
    "runner_id": {"type": "string"},
    "runner_module": {"pattern": "^cases\\.[A-Za-z0-9_.]+$"},
    "plugin_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["planned", "active", "deprecated"]}
  },
  "additionalProperties": false
}
