{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/registry.schema.json",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile_id", "profile_path", "rules_path", "status"],
        "properties": {
          "profile_id": {"type": "string"},
          "profile_path": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"},
          "rules_path": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/relativePath"},
          "status": {"enum": ["active", "planned", "deprecated"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
