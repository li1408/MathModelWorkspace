{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/model_card.schema.json",
  "type": "object",
  "required": ["schema_version", "model_id", "plugin_ids", "role", "status", "question_ids", "objective", "inputs", "outputs", "assumption_ids", "parameters", "algorithm_prerequisites", "metrics", "validations", "runtime", "runner_id", "failure_modes", "discard_reason", "extensions"],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"type": "string"},
    "plugin_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "role": {"enum": ["baseline", "main", "alternative", "upper_bound", "lower_bound", "stress_test", "discarded"]},
    "status": {"enum": ["draft", "approved", "implemented", "validated", "discarded"]},
    "question_ids": {"type": "array", "items": {"type": "string"}},
    "objective": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "assumption_ids": {"type": "array", "items": {"type": "string"}},
    "parameters": {"type": "object"},
    "algorithm_prerequisites": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "array", "items": {"type": "string"}},
    "validations": {"type": "array", "items": {"type": "string"}},
    "runtime": {"enum": ["python", "matlab"]},
    "runner_id": {"type": "string"},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "discard_reason": {"type": ["string", "null"]},
    "extensions": {"$ref": "https://mathmodel.local/schemas/common.schema.json#/$defs/extensions"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "discarded"}}},
      "then": {"properties": {"discard_reason": {"type": "string", "minLength": 1}}}
    }
  ],
  "additionalProperties": false
}
