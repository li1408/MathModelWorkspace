{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/common.schema.json",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "logicalUri": {
      "type": "string",
      "pattern": "^(asset://(?:raw|template|reference)/[a-z0-9][a-z0-9._-]*|run://[A-Za-z0-9._-]+/[A-Za-z0-9._-]+)$"
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {"type": "object"}
      },
      "additionalProperties": false,
      "default": {}
    }
  }
}
